# Copy to .env and fill in. .env is git-ignored and never copied into the Docker image.
# Every variable is optional except ANTHROPIC_API_KEY when using the claude backend.

# Secret: read only by the Anthropic client, never logged.
ANTHROPIC_API_KEY=

# Optional access key for this service: if set, POST /ask requires header X-API-Key.
# Demo-level control, not production authentication.
RAG_API_KEY=

RAG_INDEX_DIR=data/processed/index
RAG_BACKEND=claude
RAG_MIN_SCORE=0.80
RAG_CLAUDE_MODEL=claude-haiku-5-5
RAG_OLLAMA_MODEL=llama3.2
RAG_OLLAMA_URL=http://localhost:11434
RAG_MAX_CONTEXT_TOKENS=6000
RAG_MAX_ANSWER_TOKENS=16000
RAG_LLM_TIMEOUT_S=60
RAG_LOG_LEVEL=INFO
